" ideavim specific settings - https://github.com/jetbrains/ideavim/wiki/%22set%22-commands
set keymodel=startsel,stopsel
set ideajoin
set showmode
set showcmd
set idearefactormode=keep
set clipboard^=unnamed,unnamedplus,ideaput
set incsearch
set startofline=on
set scrolloff=8

"==================== Emulated Plugins ====================
Plug 'tpope/vim-surround'
Plug 'vim-scripts/ReplaceWithRegister'
Plug 'machakann/vim-highlightedyank'
Plug 'dbakker/vim-paragraph-motion'
Plug 'vim-scripts/argtextobj.vim'

"==================== Vim Settings ====================
set visualbell
set noerrorbells

"==================== Vim Mappings ====================
" Leader
let mapleader = " "

" Open the current file in the project view
nmap - <Action>(SelectInProjectView)

" Keep view centered when moving by paragraph
nnoremap { {zz
nnoremap } }zz

" Toggle between the first non-blank character and column zero
nnoremap <expr> <silent> 0 col('.') == len(getline('.')) - len(trim(getline('.'), '', 1)) + 1 ? '0' : '^'

" Backspace in Visual mode deletes without overwriting a register
xnoremap <BS> "_d

" Split navigation
nnoremap <C-j> <C-w><C-j>
nnoremap <C-k> <C-w><C-k>
nnoremap <C-l> <C-w><C-l>
nnoremap <C-h> <C-w><C-h>

" Delete to the end of the word without overwriting a register
nnoremap <C-Del> "_de
xnoremap <C-Del> "_de
inoremap <C-Del> <C-o>"_de

" Delete the previous word without overwriting a register
inoremap <C-h> <C-o>"_db
cnoremap <C-h> <C-w>

" Move by visual lines
nnoremap j gj
nnoremap k gk
xnoremap j gj
xnoremap k gk
nnoremap <Down> gj
xnoremap <Down> gj
inoremap <Down> <C-\><C-o>gj
nnoremap <Up> gk
xnoremap <Up> gk
inoremap <Up> <C-\><C-o>gk

" Keep view centered when navigating vertically
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

" Keep view centered when searching
nnoremap n nzz
nnoremap N Nzz

" Return to Normal mode and save only when modified
nnoremap <C-s> <Esc>:update<CR>
xnoremap <C-s> <Esc>:update<CR>
inoremap <C-s> <Esc>:update<CR>

" Remap original CTRL-A functionality to <leader>
nnoremap <leader><C-a> <C-a>
xnoremap <leader><C-a> <C-a>
" CTRL-A is Select All '$VIMRUNTIME/mswin.vim'
nnoremap <C-a> ggVG
inoremap <C-a> <C-o>gg<C-o>gH<C-o>G

" Remap original CTRL-X functionality to <leader>
nnoremap <leader><C-x> <C-x>
xnoremap <leader><C-x> <C-x>
" CTRL-X and SHIFT-Del are Cut in Visual
xnoremap <C-x> "+x
xnoremap <S-Del> "+x
" CTRL-X on a line in normal mode cuts the entire line
nnoremap <C-x> dd
nnoremap <S-Del> dd

" CTRL-C and C-Insert are Copy
xnoremap <C-c> "+y
xnoremap <C-Insert> "+y
" CTRL-C on a line in normal mode copies the entire line
nnoremap <C-c> yy

" CTRL-Space invokes completion in Insert mode
imap <C-Space> <Action>(CodeCompletion)

" Y behaves like D, C, etc.
nnoremap Y y$
xnoremap Y $y

" CTRL-V and SHIFT-Insert are Paste
imap <C-v> <Action>(EditorPaste)
xnoremap <C-v> P
cnoremap <C-v> <C-r>+
imap <S-Insert> <Action>(EditorPaste)
cnoremap <S-Insert> <C-r>+

" Go to definition
nmap gd <Action>(GotoDeclaration)

"==================== IdeaVim Action Mappings ====================
nnoremap <C-w>q <C-w>c
map <C-w>m <Action>(MaximizeEditorInSplit)

" Global leader mappings
nnoremap <leader>" :registers<CR>
nnoremap <leader>' :marks<CR>
nmap <leader>* <Action>(FindUsagesInFile)
nmap <leader>, <Action>(Switcher)
nmap <leader>. <Action>(GotoFile)
nmap <leader>/ <Action>(Find)
nmap <leader>: <Action>(GotoAction)
nnoremap <leader>` <C-^>
nnoremap <leader>j :jumps<CR>
nnoremap <leader>O O<Esc>
nnoremap <leader>o o<Esc>

" Leader-b (Buffers)
nmap <leader>bb <Action>(Switcher)
nnoremap <leader>bd :bdelete<CR>
nnoremap <leader>bl <C-^>
nnoremap <leader>bn :bnext<CR>
nnoremap <leader>bp :bprevious<CR>
nnoremap <leader>bS :wall<CR>
nmap <leader>bx <Action>(NewScratchFile)

" Leader-c (Code)
nmap <leader>ca <Action>(ShowIntentionActions)
nmap <leader>cd <Action>(GotoDeclaration)
nmap <leader>cD <Action>(GotoDeclarationOnly)
nmap <leader>ch <Action>(ShowHoverInfo)
nmap <leader>cI <Action>(GotoImplementation)
nmap <leader>ci <Action>(CallHierarchy)
nmap <leader>cn <Action>(RenameElement)
nmap <leader>co <Action>(CallHierarchy)
nmap <leader>cr <Action>(ShowUsages)
nmap <leader>cs <Action>(FileStructurePopup)
nmap <leader>cS <Action>(GotoSymbol)
nmap <leader>ct <Action>(GotoTypeDeclaration)

" Leader-d (Diagnostic)
map <leader>dn <Action>(GotoNextError)
map ]d <Action>(GotoNextError)
map <leader>dp <Action>(GotoPreviousError)
map [d <Action>(GotoPreviousError)

" Leader-f (Files)
nmap <leader>ff <Action>(GotoFile)
nmap <leader>fr <Action>(RecentFiles)
nmap <leader>fy <Action>(CopyFileName)
nmap <leader>fY <Action>(CopyPathFromRepositoryRootProvider)

" Leader-h (Help)
nmap <leader>hp <Action>(WelcomeScreen.Plugins)
nmap <leader>hr <Action>(HelpTopics)

" Leader-s (Search)
nnoremap <leader>s' :marks<CR>
nmap <leader>s* <Action>(FindUsagesInFile)
nnoremap <leader>sj :jumps<CR>
nmap <leader>sm <Action>(ShowBookmarks)
nmap <leader>ss <Action>(FindUsages)
nmap <leader>st <Action>(FindInPath)
nmap <leader>su <Action>(LocalHistory.ShowHistory)

" Leader-t (Toggle)
nmap <leader>tf <Action>(PopupHector)
nmap <leader>tw <Action>(EditorToggleUseSoftWraps)

" Leader-w (Windows)
nnoremap <leader>w+ <C-w>+
nnoremap <leader>w- <C-w>-
nnoremap <leader>w<lt> <C-w><lt>
nnoremap <leader>w= <C-w>=
nnoremap <leader>w> <C-w>>
nnoremap <leader>wf :split <C-r><C-f><CR>
nmap <leader>wn <Action>(SplitHorizontally)<Action>(NewScratchFile)
nnoremap <leader>wo <C-w>o
nmap <leader>wp <Action>(PrevSplitter)
nnoremap <leader>wq <C-w>c
nnoremap <leader>ws <C-w>s
nnoremap <leader>wv <C-w>v

" Leader-r (Refactor-Something)
map <leader>rc <Action>(Refactorings.QuickListPopupAction)
map <leader>re <Action>(ExtractMethod)
map <leader>rt <Action>(ChangeTypeSignature)

" Leader-v[a-z] (Vim-Something)
