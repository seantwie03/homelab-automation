# KDE Plasma workstation image. The build context is this directory. See
# README.md for build commands.

ARG FEDORA_MAJOR_VERSION=44

FROM quay.io/fedora/fedora-kinoite:${FEDORA_MAJOR_VERSION}

COPY scripts/ansible.sh /tmp/scripts/
RUN /tmp/scripts/ansible.sh && rm -rf /tmp/scripts

COPY scripts/base.sh /tmp/scripts/
RUN /tmp/scripts/base.sh && rm -rf /tmp/scripts

COPY scripts/updates.sh /tmp/scripts/
RUN /tmp/scripts/updates.sh && rm -rf /tmp/scripts

COPY keys/1password.asc /tmp/keys/
COPY scripts/onepassword.sh /tmp/scripts/
RUN /tmp/scripts/onepassword.sh && rm -rf /tmp/scripts /tmp/keys

# h manages this host's ansible-pull. Its settings come from
# /etc/ansible-pull.conf, which the ansible_pull role writes.
COPY --chmod=0755 bin/h /usr/bin/h
COPY --chmod=0644 bin/h.bash-completion /usr/share/bash-completion/completions/h

RUN bootc container lint --fatal-warnings
