[Unit]
Description=Ansible Pull Workstation Configuration
Documentation={{ homelab_ansible_repo_url }}
After=network-online.target
After=dnf-makecache.service
After=dns-online.service
Wants=network-online.target
Wants=dns-online.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/run/ansible-pull.env
ExecStartPre=-/bin/bash -c "echo PRE_NUM=$(snapper create --type pre --print-number --description 'Before ansible-pull' --cleanup-algorithm number) > /run/ansible-pull.env"
WorkingDirectory={{ playbook_path }}
Environment="PYTHONUNBUFFERED=True"
# Block suspend for the whole run. A run frozen by suspend continues on resume
# before the network is back, and its next download fails.
ExecStart=/usr/bin/systemd-inhibit \
    --what=sleep \
    --mode=block \
    --who=ansible-pull \
    "--why=Applying homelab configuration" \
    /bin/bash -c "set -o pipefail; {{ ansible_pull_path }} \
    --limit localhost \
    --accept-host-key \
    --directory {{ playbook_path }} \
    --url {{ homelab_ansible_repo_git }} \
    --diff \
    --verbose \
    {{ ansible_facts['hostname'] }}.yml \
    2>&1 | tee /var/log/ansible-pull/ansible-pull-$(date --iso-8601='minutes').log"
ExecStopPost=-/bin/bash -c "snapper create --type post --pre-number $PRE_NUM --description 'After ansible-pull' --cleanup-algorithm number && rm -f /run/ansible-pull.env"
ExecStopPost=-/usr/local/bin/ansible-pull-notify.sh

[Install]
WantedBy=multi-user.target
